DATABASE_URL=postgresql+psycopg://carbonai_user:CHANGE_ME@localhost:5432/carbonai
SESSION_TIMEOUT_MINUTES=30
# Optional; core calculations never need it
ANTHROPIC_API_KEY=
# SQLite file used by the app (default: data/carbonai.db). Leave unset to use the default.
CARBONAI_DB_PATH=
# Optional TTF with Arabic glyphs for the Arabic PDF (default: Windows Arial/Tahoma if present)
CARBONAI_FONT=
